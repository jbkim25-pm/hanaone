# ============================================================
#  모아버거 키오스크 환경변수 (예시)
#  이 파일을 복사해서  .env  로 저장한 뒤 실제 값을 채우세요.
#      복사:  copy .env.example .env   (Windows)
#  ⚠️  .env 파일은 절대 git 에 커밋하지 마세요 (.gitignore 에 포함됨)
#  ※ 아래 값이 비어 있어도 앱은 '데모(폴백) 모드'로 정상 실행됩니다.
# ============================================================

# --- OpenAI : 음성주문(Whisper STT + GPT 매칭)에 필요 ---
# 없으면 음성주문 버튼이 비활성화되고 터치주문만 동작합니다.
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_MATCH_MODEL=gpt-4o-mini

# --- Supabase : 메뉴/주문 DB (없으면 로컬 data/menu.json 사용) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- 날씨 API : 온도 기반 추천 (없으면 아래 기본 기온 사용) ---
# OpenWeatherMap 사용 시 키 입력. (https://openweathermap.org/api)
WEATHER_API_KEY=
STORE_LAT=37.4979
STORE_LON=127.0276
# 날씨 API 미사용/실패 시 사용할 기본 기온(℃)
DEFAULT_TEMP=28

# --- 서버 설정 ---
#FLASK_HOST=127.0.0.1
#FLASK_PORT=5000
#FLASK_DEBUG=1
